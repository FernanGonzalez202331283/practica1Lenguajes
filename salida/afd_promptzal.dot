digraph AFD_PromptZal {
  rankdir=LR;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];

  __inicio [shape=point, style=invis];
  __inicio -> q0;

  q1 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q3 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q4 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q6 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q8 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q9 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q10 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q11 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q13 [shape=circle, peripheries=2, style=filled, fillColor="#d5e8d4", color="#82b366"];
  q0 [shape=circle, style=filled, fillColor="#dae8fc", color="#6c8ebf"];
  q2 [shape=circle, style=filled, fillColor="#ffe6cc", color="#d79b00"];
  q5 [shape=circle, style=filled, fillColor="#ffe6cc", color="#d79b00"];
  q7 [shape=circle, style=filled, fillColor="#ffe6cc", color="#d79b00"];
  q12 [shape=circle, style=filled, fillColor="#ffe6cc", color="#d79b00"];
  q14 [shape=circle, style=filled, fillColor="#ffe6cc", color="#d79b00"];
  q15 [shape=circle, style=filled, fillColor="#fff2cc", color="#d6b656"];
  q16 [shape=circle, style=filled, fillColor="#fff2cc", color="#d6b656"];
  q17 [shape=circle, style=filled, fillColor="#fff2cc", color="#d6b656"];
  qE [shape=circle, style=filled, fillColor="#f8cecc", color="#b85450"];

  q0 -> q1  [label="L, _"];
  q0 -> q2  [label="@"];
  q0 -> q4  [label="D"];
  q0 -> q7  [label="\""];
  q0 -> q9  [label="="];
  q0 -> q10 [label="+"];
  q0 -> q11 [label="{ } ( ) ,"];
  q0 -> q12 [label="-"];
  q0 -> q14 [label="/"];
  q0 -> q0  [label="esp, \\n"];
  q0 -> qE  [label="otro", color="#b85450", fontcolor="#b85450"];

  q1 -> q1 [label="L, D, _"];
  q2 -> q3 [label="L"];
  q2 -> qE [label="D, _, otro", color="#b85450", fontcolor="#b85450"];
  q3 -> q3 [label="L, D, _"];

  q4 -> q4 [label="D"];
  q4 -> q5 [label="."];
  q5 -> q6 [label="D"];
  q5 -> qE [label="otro", color="#b85450", fontcolor="#b85450"];
  q6 -> q6 [label="D"];

  q7 -> q7 [label="cualquiera != \", != \\n (incluye esp)"];
  q7 -> q8 [label="\""];
  q7 -> qE [label="\\n", color="#b85450", fontcolor="#b85450"];

  q12 -> q13 [label=">"];
  q12 -> qE  [label="otro", color="#b85450", fontcolor="#b85450"];

  q14 -> q15 [label="/"];
  q14 -> q16 [label="*"];
  q14 -> qE  [label="otro", color="#b85450", fontcolor="#b85450"];
  q15 -> q15 [label="!= \\n"];
  q15 -> q0  [label="\\n (sin emitir token)", style=dashed];
  q16 -> q16 [label="!= *"];
  q16 -> q17 [label="*"];
  q17 -> q16 [label="!= /, != *"];
  q17 -> q17 [label="*"];
  q17 -> q0  [label="/ (sin emitir token)", style=dashed];

  qE -> q0 [label="cualquiera (reporta error y reinicia)", color="#b85450", fontcolor="#b85450"];
}
